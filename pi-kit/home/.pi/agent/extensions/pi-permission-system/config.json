{
  // Allow by default, matching a bypass-style workflow. Guard only destructive commands and secret paths.
  // Note: bash deny patterns match the literal spelling, so quoting tricks can slip past them. The path rules are the stronger guard.
  // yoloMode auto-approves every "ask" (wrapper floors like `timeout`/`env`, unparseable heredocs, and the ask rules below). Explicit "deny" rules still deny.
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      // Kill by saved PID or port, never by name pattern: a pattern also hits the find-gaps runner, pi-web and other
      // sessions (pi is node). 2026-10-18: a loop builder's `pgrep -f "run\.sh" | xargs kill` stopped the loop 6.5 h.
      "pkill *": "deny",
      "killall *": "deny",
      "xargs *kill*": "deny",
      "kill *pgrep*": "deny",
      "kill *pidof*": "deny",
      // `*` is always a wildcard (no escape) and the LAST matching rule wins.
      // So: deny every absolute path, re-allow scratch paths under /tmp, then
      // re-deny a /tmp command that also names a path outside /tmp or under ~.
      "rm -rf /*": "deny",
      "rm -rf /tmp/*": "allow",
      "rm -rf /tmp/* /*": "deny",
      "rm -rf /tmp/* ~*": "deny",
      "rm -rf ~*": "deny",
      // pi-permission-system >= 40 also matches the absolute spelling of a relative path, so
      // `cd <repo> && rm -rf ./dist` now hits "rm -rf /*". Re-allow the work trees (absolute or relative).
      // Same shape as the /tmp rules: one target at a time, so a second path re-denies.
      "rm -rf /home/loop/projects/*/*": "allow",
      "rm -rf /home/loop/pi-lab/*": "allow",
      "rm -rf /home/loop/projects/*/* /*": "deny",
      "rm -rf /home/loop/projects/*/* ~*": "deny",
      "rm -rf /home/loop/pi-lab/* /*": "deny",
      "rm -rf /home/loop/pi-lab/* ~*": "deny"
    },
    "path": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.codex/auth.json": "deny",
      // full pi-maint key (production writes): only ~/bin/pi-maint uses it, from the interactive session
      "~/.config/pi-maint/id_ed25519": "deny"
    }
  }
}
